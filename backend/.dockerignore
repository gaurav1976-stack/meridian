# Meridian backend — Docker build hygiene.
# Keep the build context small so `docker build` is fast and the image layers
# don't leak local virtualenvs, caches, or secrets.

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.tox
.nox

# Virtualenvs
.venv
venv
env
.env
.env.*
!.env.example

# IDE / editor
.idea
.vscode
*.swp

# OS
.DS_Store
Thumbs.db

# Local artifacts + SQLite
meridian.db
*.sqlite
*.sqlite3
/data

# Git
.git
.gitignore

# Documentation / misc
*.md
