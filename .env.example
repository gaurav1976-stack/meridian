# Meridian — environment configuration template
# Copy to .env for local development. Never commit .env.

# ----- Backend -----
APP_NAME=Meridian API
API_VERSION=0.1.0
DEBUG=true

# Postgres (dev)
DATABASE_URL=postgresql+psycopg://meridian:meridian@postgres:5432/meridian
# For host-side tooling (alembic, scripts) use:
# DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian

# Redis (queues + workers)
REDIS_URL=redis://redis:6379/0

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_AUDIENCE=meridian-api
JWT_ISSUER=https://example.com/oauth2
JWT_JWKS_URL=https://example.com/.well-known/jwks.json
ALLOW_DEV_AUTH_BYPASS=true

# Storage adapter: local | s3 | azure
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORAGE_LOCAL_DIR=/data/artifacts

# Vector store: mock | pgvector | opensearch
VECTOR_STORE_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=mock-deterministic-32d

# Hybrid retrieval weights
HYBRID_KEYWORD_WEIGHT=0.30
HYBRID_CHUNK_WEIGHT=0.30
HYBRID_SEMANTIC_WEIGHT=0.40

# ----- Connectors (leave blank in dev — adapters short-circuit) -----
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_DEFAULT_HUB_ID=

MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ----- Frontend -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Meridian

# ----- Basic Auth front door (pilot-demo only) -----
# When BOTH are set, every request to either the frontend or backend must
# present matching HTTP Basic credentials. Leave blank for local dev.
# Used by:
#   - backend/app/core/basic_auth.py (FastAPI middleware)
#   - frontend/src/middleware.ts     (Next.js edge middleware)
#   - frontend/src/lib/api/client.ts (SSR pass-through)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
